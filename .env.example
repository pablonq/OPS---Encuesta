# Supabase (Project Settings -> API)
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Service role key: NUNCA exponerla al cliente. Solo se usa en las API routes del servidor.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Acceso al panel /admin (gate simple por contraseña, no es un sistema de usuarios)
ADMIN_PASSWORD=elegir-una-contraseña-segura
ADMIN_SESSION_SECRET=una-cadena-larga-y-aleatoria
